{
  "name": "react-empty-project",
  "version": "0.0.1",
  "description": "react-empty-project",
  "main": "webpack.config.ts",
  "sideEffects": false,
  "scripts": {
    "typings-scss-modules": "yarn typed-scss-modules components/ --exportType default --nameFormat none --implementation sass",
    "install-package": "yarn install",
    "build-dev": "yarn run typings-scss-modules && webpack --mode development --progress --stats-error-details",
    "build-prod": "yarn run typings-scss-modules && cross-env NODE_ENV=production webpack --mode production --progress --stats-error-details",
    "run-http-server": "serve -s ./build"
  },
  "keywords": [
    "react-empty-project"
  ],
  "author": "Ivan",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/plugin-transform-runtime": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@babel/runtime": "8.0.5",
    "@svgr/webpack": "8.1.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@types/uuid": "11.0.0",
    "@types/webpack": "5.28.5",
    "babel-loader": "10.1.1",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "7.1.5",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "sass-loader": "17.0.1",
    "serve": "^14.2.6",
    "svg-transform-loader": "2.0.13",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typed-scss-modules": "8.1.1",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "5.2.0",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "dependencies": {
    "axios": "1.20.0",
    "babel-plugin-react-css-modules": "5.2.6",
    "babel-preset-react-app": "10.1.0",
    "cross-env": "^10.1.0",
    "css-loader-minify-class": "1.3.0",
    "http-server": "14.1.1",
    "lottie-react": "^3.1.2",
    "mini-svg-data-uri": "1.4.4",
    "mobx": "7.0.5",
    "mobx-react": "10.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sass": "^1.105.0",
    "uuid": "14.0.2"
  }
}
